# ListMak App Environment Configuration (Example)

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

# App Configuration
VITE_APP_NAME=ListMak
VITE_APP_VERSION=1.0.0

# Testing mode: set to "true" to show a sticky yellow "TESTING" banner on all pages.
VITE_TESTING_MODE=false

# Server Configuration
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=5173
VITE_SERVER_ALLOWED_HOSTS=localhost
VITE_API_PROXY_TARGET=http://localhost:9001
