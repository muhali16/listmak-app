PORT=9001
ENV=development

DB_HOST=localhost
DB_NAME=listmak_service
DB_PORT=5432
DB_USER=postgres
DB_PASS=

GOOGLE_CLIENT_ID=your_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_secret
GOOGLE_REDIRECT_URL=http://localhost:9001/api/v1/auth/google/callback

JWT_SECRET=secret

FRONTEND_URL=http://localhost:5173
FRONTEND_DOMAIN=example.com

ADMIN_EMAILS=youremail@gmail.com

# --- Runtime-tunable settings (env only SEEDS the initial DB value on first run;
#     after that, admin changes them at runtime via the Konfigurasi page) ---

# Testing/sandbox mode default.
TESTING_MODE=false

# Fireworks AI. API key stays server-side (secret); the MODEL is runtime-tunable.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# Pakasir payment gateway. Leave PROJECT/API_KEY empty to disable payments (checkout -> 503).
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_PROJECT=your_project_slug
PAKASIR_API_KEY=your_api_key
